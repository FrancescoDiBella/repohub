# RepoHub configuration. Copy this file to `.env` (never commit `.env`) and fill it in.
# Values may contain spaces, with or without quotes. Lines starting with # are comments.
#
# Where configuration is read from:
# - Process environment: variables already exported in your shell have highest precedence.
# - Installed (release) builds: read configuration from the app settings file (<data dir>/.env),
#   or from an explicit settings file when set via REPOHUB_ENV=/path/to/file.env.
# - Development (debug) builds: also search upward for a project `.env`, but security-sensitive
#   keys (GITHUB_API_URL, REPOHUB_UPDATE_API, REPOHUB_CLAUDE, REPOHUB_DATA_DIR,
#   REPOHUB_TERMINAL_COMMANDS, REPOHUB_REPOS_DIR) are ignored in upward-discovered files.
# - A token saved in the app settings (<data dir>/.env) is never redirected by a project `.env`:
#   its API host always comes from the settings file, the process environment, or defaults to
#   https://api.github.com.

# GitHub personal access token. Optional for public data; needed for private repositories,
# to raise the rate limit from 60 to 5,000 requests an hour, and to star from the app.
# Recommended: a fine-grained token (github.com/settings/personal-access-tokens) with
#   Repository access: all your repositories (or the ones you want to see)
#   Repository permissions: Metadata and Actions (read); Contents, Issues and Pull requests
#   (read and write, to create branches, issues and pull requests and merge from the app)
#   Account permissions: Starring (read and write), to star and unstar from the app
GITHUB_TOKEN=

# Organizations whose repositories to show next to yours: empty for all you belong to, none for
# only your own, or a list (acme,xr-lab). Private ones need a token that can see them: a classic
# token with repo and read:org, or a fine-grained token whose resource owner is the organization.
REPOHUB_ORGS=

# Whose repositories to show. Leave empty to use the token's owner.
GITHUB_USER=

# REST API base. Change it only for GitHub Enterprise Server: https://your-host/api/v3
GITHUB_API_URL=https://api.github.com

# Name shown at the top of the sidebar.
REPOHUB_TITLE=RepoHub

# Theme: system, light or dark.
# This is only the default: a theme picked in the app (toolbar button or Settings) is remembered.
REPOHUB_THEME=system

# Repositories under "Pinned", comma-separated (name or owner/name).
# Empty: the three most recently pushed. This is only the default: once you pin or unpin
# a repository in the app, your pins are remembered instead.
REPOHUB_PINNED=

# Include forks and archived repositories.
REPOHUB_INCLUDE_FORKS=true
REPOHUB_INCLUDE_ARCHIVED=false

# How many repositories to read at most.
REPOHUB_MAX_REPOS=100

# How many repositories (the most recently pushed) to read workflow runs and weekly commits from.
# Each one costs 2 API requests per refresh.
REPOHUB_ACTIVITY_REPOS=5

# Desktop app, Terminal tab: folders where your clones live (comma-separated). Empty: ~/Developer,
# ~/Projects, ~/code, ~/src, ~/GitHub, ~/repos and ~/Documents/GitHub.
REPOHUB_REPOS_DIR=

# Desktop app: off stops looking for new versions of the app (it checks the Latest build on
# GitHub at start and every 6 hours, and asks before installing).
REPOHUB_UPDATES=on

# Desktop app: 0 hides the status-bar icon (menu bar on macOS, notification area on Windows).
# With it, closing the window keeps RepoHub running there.
REPOHUB_TRAY=1

# Desktop app, Claude tab: the claude program, when it isn't in ~/.local/bin, /opt/homebrew/bin,
# /usr/local/bin or on your login shell's PATH.
REPOHUB_CLAUDE=

# Desktop app, Terminal tab: the command buttons, separated by ; (coding assistants such as
# claude or codex are set in Settings -> Coding assistants)
REPOHUB_TERMINAL_COMMANDS=git status;git pull;git log --oneline -15

# Minutes between automatic refreshes while an account is connected; 0 turns them off.
# Without a token RepoHub never refreshes more often than every 30 minutes (60 requests an hour).
REPOHUB_REFRESH_MINUTES=10

# true shows the sample data even when a token is set.
REPOHUB_DEMO=false

# Docker only: extra host names the server accepts besides localhost (comma-separated).
# REPOHUB_ALLOWED_HOSTS=
